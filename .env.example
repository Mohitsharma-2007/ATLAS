# Neo4j Aura: copy the URI from Aura -> Connect -> Drivers.
NEO4J_URI=neo4j+s://YOUR_AURA_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
NEO4J_QUERY_API_URL=https://YOUR_AURA_INSTANCE.databases.neo4j.io/db/neo4j/query/v2

# Paper discovery uses OpenAlex and does not need an API key.
# OPENALEX_MAILTO=you@example.com

# OpenAI-compatible synthesis/extraction. OpenRouter is the default; Groq/NVIDIA are supported.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Keep this aligned with the Neo4j vector index dimension.
EMBEDDING_DIMENSIONS=384
REQUEST_TIMEOUT_SECONDS=30
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
